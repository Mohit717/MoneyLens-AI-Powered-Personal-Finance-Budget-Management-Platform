// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  name            String?
  role            Role           @default(USER)
  isEmailVerified Boolean        @default(false)
  status          UserStatus    @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  logs            AuditLog[]

  @@map("users")
}

model RefreshToken {
  id              String   @id @default(uuid())
  tokenHash       String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId        String   // Group tokens for theft detection & rotation
  isRevoked       Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime? @updatedAt
  revokedAt       DateTime?
  revokeReason    String?
  replacedById    String?
  ipAddress       String?
  userAgent       String?
  

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  level      String   // info, warn, error, fatal
  action     String   // AUTH_REGISTER_SUCCESS, AUTH_LOGIN_SUCCESS, AUTH_LOGIN_FAILED, TOKEN_REFRESH, etc.
  message    String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model OtpCode {
  id        String     @id @default(uuid())
  email     String
  codeHash  String     // SHA-256 hash of the 6-digit code
  purpose   OtpPurpose
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  @@index([email, purpose])
  @@map("otp_codes")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}